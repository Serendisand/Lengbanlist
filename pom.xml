<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.leng</groupId>
    <artifactId>lengbanlist-parent</artifactId>
    <version>2.2.1</version>
    <packaging>pom</packaging>

    <name>Lengbanlist Parent</name>
    <description>Lengbanlist 多模块构建父工程：契约模块（lengbanlist-api）与主插件（Lengbanlist）</description>
    <url>https://github.com/Serendisand/Lengbanlist</url>

    <licenses>
        <license>
            <name>Mozilla Public License 2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Serendisand</id>
            <name>Serendisand</name>
            <url>https://github.com/Serendisand</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Serendisand/Lengbanlist.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Serendisand/Lengbanlist.git</developerConnection>
        <url>https://github.com/Serendisand/Lengbanlist</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Lengbanlist Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/serendisand/Lengbanlist</url>
        </repository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <modules>
        <module>lengbanlist-api</module>
        <module>Lengbanlist - main</module>
    </modules>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>spigot-release-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/releases/</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
        <repository>
            <id>aliyun-maven</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi-repo</id>
            <url>https://repo.helpch.at/releases</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.leng</groupId>
                <artifactId>lengbanlist-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
